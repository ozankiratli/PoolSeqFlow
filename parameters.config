// PoolSeqFlow parameters.
//
// This file is the only supported way to configure a run. Do not override parameters on
// the command line (`nextflow run ... --poolSize 50`): Nextflow passes CLI parameters as
// strings, so `--annotate false` sets the string "false", which evaluates as true and
// silently leaves annotation enabled. Values set here keep their real types.
// The ./PoolSeqFlow wrapper takes a single subcommand and rejects extra arguments.

params {
    //main parameters
    threads         = 4
    mainDir         = "/home/user/PoolSeqFlow"
    projectDir      = "${params.mainDir}/Project"
    dataSource      = 'Data'
    readPattern     = "*_R{1,2}.fq.gz"
    referenceFile   = 'reference.fasta.gz'
    poolSize        = 100
    diploidy        = 2
    rgTagsFile      = 'RGTags.csv'
    annotate        = true
    gffFile         = 'reference.gff.gz'

    referenceFa     = "${params.referenceFile.replace('.gz', '')}"
    referencePath   = "${params.projectDir}/${params.referenceFile}"
    gffPath         = "${params.projectDir}/${params.gffFile}"
    rgTagsPath      = "${params.projectDir}/${params.rgTagsFile}"

    // Core allocation - all derived from `threads` above. Do not set the per-tool
    // thread counts by hand; change `threads` and everything follows.
    //
    // Each tool is quantised to the largest power of two at or below `threads`, capped
    // at 8, which is where the published scaling for these tools flattens out. Setting
    // threads = 1 forces every tool to a single core.
    cores {
        ladder      = params.threads >= 8 ? 8 : (params.threads >= 4 ? 4 : (params.threads >= 2 ? 2 : 1))

        // Trim Galore is costed on its full footprint, not its worker count: --cores N
        // runs N+4 threads (N workers + 2 decompressors + 1 batcher + 1 writer) for any
        // N >= 2, while --cores 1 bypasses the pool and is genuinely single-threaded.
        // So pick the largest N whose N+4 still fits in `threads`:
        //   12+ cores -> 8    8+ -> 4    6+ -> 2    otherwise -> 1
        trim        = params.threads >= 12 ? 8 : (params.threads >= 8 ? 4 : (params.threads >= 6 ? 2 : 1))
        trimTotal   = params.cores.trim > 1 ? params.cores.trim + 4 : 1   // threads actually spawned

        bwa         = params.cores.ladder   // bwa mem -t N
        cutadapt    = params.cores.ladder   // cutadapt --cores N
        fastqc      = params.threads >= 2 ? 2 : 1   // one thread per file; step 2 only ever hands it a pair

        // samtools -@ counts ADDITIONAL threads, so 0 means one core and 1 means two.
        samtools    = params.threads >= 2 ? 1 : 0
        // Same core count as samtools, kept as its own value so it can be tuned
        // independently. -XX:ParallelGCThreads is a total, not an increment.
        javaGc      = params.cores.samtools + 1
    }

    // java parameters
    java {
        heapSize        = '-Xmx8g'
        garbageCollect  = "-XX:ParallelGCThreads=${params.cores.javaGc}"
        options         = "${params.java.heapSize} ${params.java.garbageCollect}"
    }

    // fastqc parameters
    fastqc {
        threads         = params.cores.fastqc
        memory          = 2048  // megabytes, as a plain number - FastQC rejects "2G"
        // For the standalone FastQC binary (used on the clipped reads in step 2).
        options         = "-t ${params.fastqc.threads} --memory ${params.fastqc.memory}"
        // For Trim Galore's bundled FastQC engine, which understands only a subset of
        // FastQC's flags (-t, -o, --nogroup, --quiet, --svg, ...). Anything else warns
        // and is ignored, so --memory must not be passed here.
        bundledOptions  = "-t ${params.fastqc.threads}"
    }
    
    // trim_galore parameters
    trim_galore {
        threads         = params.cores.trim
        quality         = 25
        // true  -> no adapter is passed; Trim Galore auto-detects it (Illumina/Nextera/smallRNA)
        //          and adapter1/adapter2 below are ignored.
        // false -> BOTH adapter1 and adapter2 must be set to your provider's sequences.
        autodetect      = true
        adapter1        = 'AATGATACGGCGACCACCGAGATCTACACTCTTTCCCTACACGACGCTCTTCCGATCT'
        adapter2        = 'GATCGGAAGAGCACACGTCTGAACTCCAGTCACATCACGATCTCGTATGCCGTCTTCTGCTTG'
        adapterOptions  = params.trim_galore.autodetect ? '' : "-a ${params.trim_galore.adapter1} -a2 ${params.trim_galore.adapter2}"
        options         = "--cores ${params.trim_galore.threads} --fastqc --fastqc_args \"${params.fastqc.bundledOptions}\" --paired --retain_unpaired -q ${params.trim_galore.quality} ${params.trim_galore.adapterOptions}"
    }
    
    cutadapt {
        threads        = params.cores.cutadapt
        at_gc_error    = 0.025 
        min_length     = 50
        options        = "--cores ${params.cutadapt.threads}" 
    }

    // BWA parameters
    bwa {
        threads         = params.cores.bwa
        minScoreOutput  = 30
        batchSize       = 10000000
        options         = "-t ${params.bwa.threads} -K ${params.bwa.batchSize} -T ${params.bwa.minScoreOutput}"
    }
    
    // Samtools parameters
    samtools {
        threads         = params.cores.samtools
        filter          = "0xF0C"       // See `man samtools-flags` for more information
        required        = "0x2"         // See `man samtools-flags` for more information
        mapq            = 30
    }


    // bcftools parameters
    bcftools {
        scaleMapQ       = 50
        baseQualMin     = 30
        varQualMin      = 30
        maxDepth        = 2000
        mpileupOptions  = "-B -C ${params.bcftools.scaleMapQ} -q ${params.bcftools.baseQualMin} -Q ${params.bcftools.varQualMin} -d ${params.bcftools.maxDepth} -a AD,DP,SP,INFO/AD -Ou"

        callOptions         = "-m -A -v -Ov"  
    }

    // VCF parameters
    vcf {
        fileName        = 'Test'
    }

    // vcf Filtering parameters
    vcftools {
        minDP           = 20
        minQUAL         = 30
    }
    
    // Filter False Positives parameters
    filterFalsePositives {
        sensitivity     = 1.0 / (2 * params.diploidy * params.poolSize)
        sampleThreshold = 0.2
    }   

    // SNPEff parameters
    snpEff {
        // Derived from the GFF file name ([reference].gff.gz -> [reference].gff).
        db              = "${params.gffFile.replace('.gz', '')}"
        config          = "snpEff.config"
        buildOptions    = "-gff3 -noCheckCds -noCheckProtein -v"
        runOptions      = "-v"
    }
    
    // directories
    dir {
        data            = "${params.projectDir}/${params.dataSource}"
        outputs         = "${params.projectDir}/Output"
        references      = "${params.projectDir}/Reference"
        scripts         = "${params.mainDir}/scripts"
        bin             = "${params.mainDir}/bin"
        logs            = "${params.projectDir}/Logs"
        snpEff          = "${params.dir.references}/snpEff"

        output {
            aligned         = "${params.dir.outputs}/Aligned"
            ready           = "${params.dir.outputs}/Ready"
            trimmed         = "${params.dir.outputs}/Trimmed"
            unpaired        = "${params.dir.outputs}/Unpaired"
            vcf             = "${params.dir.outputs}/VCF"
            freq            = "${params.dir.outputs}/Frequencies"
            reports         = "${params.dir.outputs}/Reports"
            temp            = "${params.dir.outputs}/Temp"

            report {
                align           = "${params.dir.output.reports}/Alignment"
                coverage        = "${params.dir.output.reports}/Coverage"
                fastqc          = "${params.dir.output.reports}/Fastqc"
                trim            = "${params.dir.output.reports}/Trimming"
            }
        }
    }

    // setting reference and data full paths
    reference       = "${params.dir.references}/${params.referenceFile.replace('.gz', '')}"
    gff             = "${params.dir.references}/${params.gffFile.replace('.gz', '')}" 
    reads           = "${params.dir.data}/${params.readPattern}"

    // directories
    dir {
        data            = "${params.projectDir}/${params.dataSource}"
        outputs         = "${params.projectDir}/Output"
        references      = "${params.projectDir}/Reference"
        scripts         = "${params.mainDir}/scripts"
        bin             = "${params.mainDir}/bin"
        logs            = "${params.projectDir}/Logs"
        snpEff          = "${params.dir.references}/snpEff"

        output {
            aligned         = "${params.dir.outputs}/Aligned"
            ready           = "${params.dir.outputs}/Ready"
            trimmed         = "${params.dir.outputs}/Trimmed"
            unpaired        = "${params.dir.outputs}/Unpaired"
            vcf             = "${params.dir.outputs}/VCF"
            freq            = "${params.dir.outputs}/Frequencies"
            reports         = "${params.dir.outputs}/Reports"
            temp            = "${params.dir.outputs}/Temp"

            report {
                align           = "${params.dir.output.reports}/Alignment"
                coverage        = "${params.dir.output.reports}/Coverage"
                fastqc          = "${params.dir.output.reports}/Fastqc"
                trim            = "${params.dir.output.reports}/Trimming"
            }
        }
    }

    // setting reference and data full paths
    reference       = "${params.dir.references}/${params.referenceFile.replace('.gz', '')}"
    gff             = "${params.dir.references}/${params.gffFile.replace('.gz', '')}" 
    reads           = "${params.dir.data}/${params.readPattern}"

    // Add software commands. 
    // WARNING: It is possible to use the software installed on the system instead of conda environment.
    //          Replace the command with the full path of the software. 
    //          Due to version conflicts the pipeline might misbehave. 
    //          Use with caution!
    software {
        java            = 'java'
        cutadapt        = 'cutadapt'
        fastqc          = 'fastqc'
        trim_galore     = 'trim_galore'
        samtools        = 'samtools'
        bamtools        = 'bamtools'
        bwa             = 'bwa'
        bcftools        = 'bcftools'
        vcftools        = 'vcftools'
        snpEff          = 'snpEff'
        unzip           = 'unzip'
    }   
}
