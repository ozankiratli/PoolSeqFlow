@article{fabian2012latitudinal,
  group   = {Where these methods have been used},
  authors = {Fabian, Daniel K. and Kapun, Martin and Nolte, Viola and Kofler, Robert and Schmidt, Paul S. and Schl{\"o}tterer, Christian and Flatt, Thomas},
  title   = {Genome-wide patterns of latitudinal differentiation among populations of Drosophila melanogaster from North America},
  journal = {Molecular Ecology},
  volume  = {21},
  number  = {19},
  pages   = {4748--4769},
  year    = {2012},
  doi     = {10.1111/j.1365-294X.2012.05731.x},
  note    = {An early large Pool-seq study, and a worked example of what these estimators are for: pi, theta_W and Tajima's D from PoPoolation and F_ST from PoPoolation2, across populations on a cline. Useful for seeing how the numbers are reported and argued from, rather than only how they are computed.},
}
