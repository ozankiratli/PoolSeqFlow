#!/bin/bash
#
# Version: 2.2.0
# Author : Ozan L. Z. Kiratli
# email  : ozankiratli@protonmail.com
#
# Wrapper script for the PoolSeqFlow analysis layer
# Usage: ./PoolSeqFlow-analysis {install|check|<module>|complete|version|cite|uninstall}
#  install    - creates this release's analysis conda environment
#  check      - verifies the analysis installation
#  <module>   - runs one analysis module and writes its results
#  complete   - moves Analysis/ to permanent storage
#  version    - prints the version of this copy
#  cite       - prints how to cite this copy, and R and the packages it runs on
#  uninstall  - removes this release's analysis conda environment
#
# Each subcommand takes no arguments, as ./PoolSeqFlow's do. POOLSEQFLOW_PREFIX and
# POOLSEQFLOW_HOME adjust it.
#
# ./PoolSeqFlow install deploys this wrapper alongside the pipeline. What it installs and
# removes here is the analysis conda environment, not the pipeline.

set -e
eval "$(conda shell.bash hook)"

VERSION="2.2.0"

usage() {
    echo "Usage: $0 {install|check|<module>|complete|version|cite|uninstall}"
    exit 1
}

# Stamped by the pipeline's `install` into the copy it deploys; empty everywhere else. A
# default, not an override: POOLSEQFLOW_HOME still wins.
POOLSEQFLOW_INSTALLED_HOME=""

# Where this copy of PoolSeqFlow lives - the pipeline, scripts/ and bin/ - not the project,
# which is the directory you are standing in.
if [ -n "${POOLSEQFLOW_HOME:-}" ]; then
    INSTALL="$POOLSEQFLOW_HOME"
elif [ -n "$POOLSEQFLOW_INSTALLED_HOME" ]; then
    INSTALL="$POOLSEQFLOW_INSTALLED_HOME"
else
    INSTALL=$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)
fi
export POOLSEQFLOW_HOME="$INSTALL"

# Shared with the pipeline wrapper, and sourced after INSTALL resolves: nf_config_value
# reads it.
if [ ! -f "$INSTALL/lib/wrapper_lib.sh" ]; then
    echo "ERROR: $INSTALL/lib/wrapper_lib.sh is missing." >&2
    echo "  This copy of PoolSeqFlow is incomplete." >&2
    exit 1
fi
. "$INSTALL/lib/wrapper_lib.sh"

# Confirms the analysis entry point is there, for the subcommands that need it.
require_install() {
    [ -f "$INSTALL/analysis.nf" ] && return 0
    echo "ERROR: cannot find the PoolSeqFlow analysis layer." >&2
    echo "  Looked in: $INSTALL" >&2
    echo "  Expected to find analysis.nf there, alongside poolseqflow.nf." >&2
    echo "  Set POOLSEQFLOW_HOME to the directory holding it." >&2
    exit 1
}

# Refuses early when the current directory is not a project.
require_project_config() {
    [ -f parameters.config ] && return 0
    echo "ERROR: no parameters.config in $(pwd)" >&2
    echo "" >&2
    echo "The analysis layer runs in your project's directory, the same one the pipeline" >&2
    echo "runs in, and reads the results that run produced:" >&2
    echo "    cd /path/to/project" >&2
    echo "    $(basename "$0") $COMMAND" >&2
    exit 1
}

# Every analysis environment on this machine, of any version.
analysis_envs() {
    poolseqflow_envs | grep -E '^PoolSeqFlow-.+-analysis$' || true
}

# Activates this version's analysis environment, or explains its absence. Never falls back
# to the pipeline's environment or to another version's.
require_env() {
    if env_exists "$ENV_NAME"; then
        conda activate "$ENV_NAME"
        return 0
    fi

    echo "ERROR: conda environment '$ENV_NAME' not found." >&2
    echo "" >&2
    echo "The analysis layer is opt-in: it carries R and is installed separately from the" >&2
    echo "pipeline, so a working pipeline install does not bring it." >&2
    OTHERS=$(analysis_envs | grep -vxF "$ENV_NAME" || true)
    if [ -n "$OTHERS" ]; then
        echo "" >&2
        echo "Analysis environments for other versions are installed:" >&2
        echo "$OTHERS" | sed 's/^/    /' >&2
    fi
    echo "" >&2
    echo "Install this version's with:" >&2
    echo "    $(basename "$0") install" >&2
    exit 1
}

if [ "$#" -ne 1 ]; then
    usage
fi

COMMAND=$1

# One analysis environment per release, beside the pipeline's own.
ENV_NAME="PoolSeqFlow-${VERSION}-analysis"

# The pipeline's environment for this same version. Named in messages; never activated here.
PIPELINE_ENV="PoolSeqFlow-${VERSION}"

ENV_FILE="$INSTALL/install/environment-analysis.yml"

case $COMMAND in
    install)
        require_install
        [ -f "$ENV_FILE" ] || {
            echo "ERROR: $ENV_FILE is missing." >&2
            echo "  This copy of PoolSeqFlow is incomplete." >&2
            exit 1
        }
        echo "Installing conda environment '$ENV_NAME'..."
        if env_exists "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' already exists."
        else
            # -n overrides the `name:` key inside environment-analysis.yml.
            conda env create -n "$ENV_NAME" -f "$ENV_FILE"
        fi
        echo ""
        echo "The analysis layer is installed. Run a module from your project directory:"
        echo "    $(basename "$0") <module>"
        if ! env_exists "$PIPELINE_ENV"; then
            echo ""
            echo "Note: the pipeline environment '$PIPELINE_ENV' is not installed. The analysis"
            echo "layer reads results a pipeline run produced, so this machine can analyse"
            echo "results copied from elsewhere but cannot produce them."
        fi
        echo ""
        # Just created, so it is activated without the existence check the other arms make.
        conda activate "$ENV_NAME"
        bash "$INSTALL/install/check_analysis_install.sh"
        ;;

    check)
        require_install
        require_env
        bash "$INSTALL/install/check_analysis_install.sh"
        ;;

    uninstall)
        if ! env_exists "$ENV_NAME"; then
            echo "Conda environment '$ENV_NAME' is already absent."
            echo "The pipeline and its own environment are untouched by this command."
            exit 0
        fi
        # Confirmed, as ./PoolSeqFlow uninstall is.
        echo ""
        echo "This removes:"
        echo "    the analysis environment $ENV_NAME"
        echo ""
        echo "The pipeline, its own environment, and everything under Analysis/ stay where"
        echo "they are. Rebuilding this environment takes as long as it did the first time."
        echo ""
        printf 'Remove it? [y/N]: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was removed." >&2
            exit 1
        fi
        case "$CONFIRM" in
            y|Y|yes|YES|Yes) ;;
            *) echo "Aborted - nothing was removed."; exit 1 ;;
        esac
        echo "Uninstalling conda environment '$ENV_NAME'..."
        conda deactivate
        conda env remove -n "$ENV_NAME" -y
        echo ""
        echo "Only the analysis environment goes. The pipeline, its environment, and"
        echo "everything under Analysis/ are untouched."
        echo "Reinstall it with:"
        echo "    $(basename "$0") install"
        ;;

    version)
        echo "PoolSeqFlow analysis layer"
        echo "v$VERSION"
        ;;

    cite)
        # The software citation is the pipeline's: the analysis layer is part of the same
        # release and carries the same DOI.
        poolseqflow_citation "$VERSION"
        echo ""
        echo "The analysis layer also runs on R"
        echo "--------------------------------------------------------------------"
        if env_exists "$ENV_NAME"; then
            echo "Results produced by an analysis module depend on R and on the packages"
            echo "below, at the versions this release pins. Cite them alongside PoolSeqFlow."
            echo ""
            conda activate "$ENV_NAME"
            if command -v Rscript >/dev/null 2>&1; then
                # Each package's own citation, asked of R, so the version reported is the
                # one installed. Failure is not fatal: the software citation above is the
                # part a paper cannot do without.
                # shellcheck disable=SC2046
                Rscript --vanilla -e '
                    want <- commandArgs(trailingOnly = TRUE)
                    have <- rownames(installed.packages())
                    cat(format(citation(), style = "text"), sep = "\n\n")
                    for (w in want) {
                        m <- have[tolower(have) == tolower(w)]
                        if (length(m)) cat("\n", format(citation(m[1]), style = "text"), "\n", sep = "")
                    }
                ' $(analysis_r_packages) 2>/dev/null || {
                    echo "R could not be asked for its citations. Check the environment with:"
                    echo "    $(basename "$0") check"
                }
            else
                echo "Rscript is not on PATH in '$ENV_NAME', so the R citations cannot be"
                echo "read from it. Check the environment with:"
                echo "    $(basename "$0") check"
            fi
            conda deactivate
        else
            echo "Environment '$ENV_NAME' is not installed, so the R and package citations"
            echo "cannot be read from it. Install it and run this again:"
            echo "    $(basename "$0") install"
        fi
        ;;

    -*)
        usage
        ;;

    *)
        # `complete` is a module name too. analysis.nf holds the list and refuses anything
        # that is not on it, so this wrapper does not keep a second copy of it.
        require_install
        require_project_config
        require_env
        # Absolute: the pipeline lives with the installation, the project is where we stand.
        nextflow run "$INSTALL/analysis.nf" --module "$COMMAND"
        wait
        conda deactivate
        ;;
esac
