# Files that belong to the repository but not to a release download.
#
# `export-ignore` removes them from `git archive`, which is what release.yml
# builds the distributable tarball with - and also what GitHub's own
# "Source code" links produce, so the two stay consistent.
#
# Anything a run needs must NOT be listed here. release.yml asserts both
# directions: required files present, these absent.

# docs/ is generated and untracked, so it cannot reach an archive in any case; the rule
# stays as insurance. manual/ is what it is generated FROM, and is deliberately absent from
# this list: a downloaded release carries the whole manual as one readable file, so the
# documentation does not depend on the site being reachable.
docs/               export-ignore
.github/            export-ignore
mkdocs.yml          export-ignore
.gitignore          export-ignore
.gitattributes      export-ignore

# Development scratch. Listed ahead of being tracked: once these are in git they
# are kept out of every release download automatically, so tracking them costs a
# user nothing.
dev/                export-ignore
Project/            export-ignore

# The test suite and its committed fixture data. Kept in the repository so every change can
# be checked against a known dataset, kept out of releases because a user never runs it.
test/               export-ignore

# The same, for the cases a module ships with itself. They are the module's and travel with it
# when it is published on its own; inside the pipeline tarball they are what test/ is - files a
# user has no way to run and no reason to.
analysis/modules/*/test/    export-ignore

# The module catalogue, which `modules available` and `modules install` read over the network
# from this branch. A copy inside a tarball would be a second answer to what can be installed,
# frozen on the day the release was built, and modules are published after it.
analysis/modules-index.tsv  export-ignore
