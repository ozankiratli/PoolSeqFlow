--- a/test/suites/50_helpers.sh
+++ b/test/suites/50_helpers.sh
@@ -933,3 +933,64 @@ test_every_depth_decision_explains_itself() {
     reason=$(python3 "$REPO_ROOT/bin/depth_cutoff.py" "$DC_CORPUS/hill-small.tsv" | sed -n 2p)
     assert_contains "$reason" "rises again" "a capped one says what it found"
 }
+
+# Bin the depths, count what reaches each threshold. Milliseconds here; a JVM start end to end.
+cb() {
+    printf '%s' "$1" > "$HELPERS_DIR/depth.txt"
+    CB_OUT=$("$REPO_ROOT/bin/callable_bins.awk" -v binsize="${2:-1000}" -v thresholds="${3:-1,5,10}" \
+             < "$HELPERS_DIR/depth.txt" 2>"$HELPERS_DIR/stderr")
+    CB_STATUS=$?
+    CB_ERR=$(cat "$HELPERS_DIR/stderr")
+}
+
+# THE DENOMINATOR HAS TO BE RIGHT OR EVERY WINDOWED STATISTIC IS WRONG BY A CONSTANT, and a
+# constant is exactly the kind of error that produces plausible numbers.
+test_callable_bins_counts_each_threshold_separately() {
+    helpers_sandbox
+    cb 'chr1	1	3
+chr1	2	12
+chr1	1000	7
+chr1	1001	30
+'
+    assert_status 0 "$CB_STATUS" "a well-formed depth stream should bin"
+    # Positions 1-1000 are one bin: depths 3, 12 and 7 -> three reach 1, two reach 5, one reaches 10.
+    assert_contains "$CB_OUT" "chr1	1	3	2	1" "the first bin should count each threshold"
+    # 1001 opens the next bin, and 30 reaches all three.
+    assert_contains "$CB_OUT" "chr1	1001	1	1	1" "a new bin should start at binsize + 1"
+    assert_contains "$CB_OUT" "n_ge_1	n_ge_5	n_ge_10" "the header should name the thresholds"
+}
+
+# A bin boundary off by one shifts every count into its neighbor, which no total would reveal.
+test_callable_bins_puts_boundaries_where_they_belong() {
+    helpers_sandbox
+    cb 'chr1	1000	9
+chr1	1001	9
+' 1000 5
+    assert_contains "$CB_OUT" "chr1	1	1" "position 1000 belongs to the bin starting at 1"
+    assert_contains "$CB_OUT" "chr1	1001	1" "position 1001 opens the next one"
+}
+
+# Each reference sequence restarts the binning; a shared bin would merge two chromosomes.
+test_callable_bins_restart_on_a_new_sequence() {
+    helpers_sandbox
+    cb 'chr1	5	9
+chr2	5	9
+' 1000 1
+    assert_count 2 "$(printf '%s\n' "$CB_OUT" | grep -c '	1	1$')" \
+        "each sequence should get its own bin starting at 1"
+}
+
+# Silence is the failure mode: an unusable setting that produced an empty track would read as a
+# genome with nothing callable in it, and every diversity statistic would divide by zero.
+test_callable_bins_refuses_settings_it_cannot_use() {
+    helpers_sandbox
+    cb 'chr1	1	9
+' 0 1
+    assert_status 2 "$CB_STATUS" "a binsize of zero is a usage mistake"
+    assert_contains "$CB_ERR" "binsize" "and should say which setting"
+
+    cb 'chr1	1	9
+' 1000 'x'
+    assert_status 2 "$CB_STATUS" "a non-numeric threshold is a usage mistake"
+    assert_contains "$CB_ERR" "threshold" "and should say which setting"
+}
