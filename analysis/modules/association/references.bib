% JSON and most of them draw something, so both belong to the layer; a BibTeX key is defined once
% across the whole manual and the frame merges the layer's set into every published folder.

@misc{eddelbuettel2011rcpp,
  id        = {Rcpp},
  name      = {Rcpp},
  r_package = {Rcpp},
  authors   = {Eddelbuettel, Dirk and Fran{\c{c}}ois, Romain},
  title     = {Rcpp: Seamless R and C++ Integration},
  journal   = {Journal of Statistical Software},
  volume    = {40},
  number    = {8},
  pages     = {1--18},
  year      = {2011},
  url       = {https://www.jstatsoft.org/v40/i08/},
  note      = {Compiles the per-site parse at run time. The R form is the reference and the compiled one is judged against it, so a run that used the compiled path says so in the published script's header. Cited by URL and not by DOI, as every other r_package entry is: a DOI a module cites has to appear in the manual's Bibliography, and that is divided into method groups where a language binding has no place.},
}
