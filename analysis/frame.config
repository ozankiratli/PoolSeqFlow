// The analysis layer's own Nextflow configuration, loaded by ./PoolSeqFlow analysis ahead of
// anything in your project.
//
// It carries the settings every module starts from and keeps this invocation's Nextflow files
// inside Analysis/. Your own settings go in analysis.config and <module>.config beside
// parameters.config; both are read after this file and win over it.
//
// It also carries what nextflow.config carries for the pipeline. A module is its own pipeline,
// launched as its own entry script, and Nextflow reads a nextflow.config beside the entry script
// and in the launch directory - neither of which is the installation. Nothing below is a second
// copy of a pipeline setting: it is the only copy this invocation has.
//
// This file belongs to the installation and is read by every project on this machine.

// The frame's own version is NOT here: it is analysis/frame.version beside this file.
// `manifest.version` is already the PIPELINE release, which 0_verify_analysis.nf compares
// against the .poolseqflow_version the results were written with, and a manifest block here
// would override it for every analysis run.

// A file given with -c cannot see what the other configuration files set, and mainDir is needed
// below.
includeConfig "${launchDir}/parameters.config"

// Guarantees the `cores` scope exists as a map. parameters.config carries the block with every
// key commented out, and a scope containing only comments creates nothing; a module cannot make
// a top-level params key that processes can see, so it is made here, at config time.
//
// A ternary and not an `if`: the strict parser rejects `if` statements in config.
params.cores = params.containsKey('cores') && params.cores != null ? params.cores : [:]

// The helpers in bin/, which parameters.config places beside the entry script. For a module the
// entry script is the module, so this is the installation instead.
//
// It reads the environment rather than params.dir.bin: `env` is a config scope, config is read
// before the entry script, and the value analysis/lib/plan.nf puts in params.dir.bin does not
// exist yet.
env {
    PATH="${System.getenv('POOLSEQFLOW_HOME') ?: ''}/bin:\$PATH"
}

conda.enabled = true

// Remove the work/ directory once the run completes successfully.
cleanup = true

process {
    errorStrategy = 'finish'
    maxRetries = 3
    maxErrors = -1
    // Ceiling for what a task may request. Clamps; does not allocate.
    resourceLimits = [
        memory: params.memory,
        cpus: params.threads
    ]
}

// This invocation's dag, trace, timeline and report. Named apart from the pipeline's, which sit
// under Output/Reports and are the record of the run that produced the results being read. They
// describe the most recent invocation: verification and the module that follows it are two.
trace {
    enabled = true
    file = "${params.mainDir}/Analysis/Session/PoolSeqFlow_analysis_trace.txt"
    sep = '\t'
    raw = true
    overwrite = true
}

report {
    enabled = true
    file = "${params.mainDir}/Analysis/Session/PoolSeqFlow_analysis_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.mainDir}/Analysis/Session/PoolSeqFlow_analysis_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.mainDir}/Analysis/Session/PoolSeqFlow_analysis_dag.html"
    overwrite = true
}

// Beside the rest of Analysis/, not in the pipeline's work directory.
workDir = "${params.mainDir}/Analysis/work"
