% Citations for the software a run invokes. THIS FILE IS THE ONE TO EDIT: it compiles to
% citations.json beside it, and bin/write_citations.py turns that into the CITATIONS.md and
% references.bib written beside a user's results, listing only what that run actually used.
%
% Compile with dev/scripts/bib2citations.py, which also documents the fields that are not
% bibliographic. 00_static fails when the two files disagree.
%
% Slots match params.software, plus nextflow, python and poolseqflow; where a slot differs
% from the BibTeX key, `id` names it. 'when' says what has to be true for the tool to be
% invoked, and absent means always.
%
% Entries with no paper carry a url instead and are @misc. Tools that exist but are not
% citable in their own right - unzip, the JVM - carry cite = {false} with a reason, so the
% omission is recorded here rather than looking like an oversight.

@software{poolseqflow,
  name    = {PoolSeqFlow},
  authors = {Kiratli, Ozan L. Z.},
  title   = {PoolSeqFlow: a Nextflow pipeline for allele frequency analysis from pooled sequencing data},
  doi     = {10.5281/zenodo.19245611},
  url     = {https://github.com/ozankiratli/PoolSeqFlow},
  note    = {Cite the version DOI of the release you ran, not the concept DOI.},
}

