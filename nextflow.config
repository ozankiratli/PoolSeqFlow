// Your project's settings, read from the directory you launch the run in.
//
// A bare `includeConfig 'parameters.config'` resolves relative to THIS file, which lives
// with the installed pipeline - so it could only ever find a config sitting inside the
// installation. That made the install double as a workspace: one config, one project.
// `${launchDir}` is the directory you ran from, so the config travels with the project and
// one installation serves as many projects as you have directories.
//
// This include must stay ABOVE everything that reads a parameter. Config interpolation is a
// single forward pass, so a derivation placed after it sees your values, and one placed
// before it would silently compute from nothing.
includeConfig "${launchDir}/parameters.config"

// Guarantee the `cores` scope exists as a map.
//
// Every value in it is computed by scripts/resolve_parameters.nf, so parameters.config
// carries the block with all of its keys commented out - and a scope block containing only
// comments creates nothing at all, leaving params.cores null. The resolver cannot create it
// either: a new TOP-LEVEL params key made inside a module is visible only within that
// module, and processes see null. Creating it here, at config time, is global.
//
// A ternary rather than an `if`: the strict parser rejects `if` statements in config. This
// also means a parameters.config from an older release, with no cores block at all, still
// runs - the scope appears and every value in it is computed.
params.cores = params.containsKey('cores') && params.cores != null ? params.cores : [:]

// Pipeline identity. `version` is what Nextflow itself reports - in `nextflow info`, in
// the execution report, and as `workflow.manifest.version` - and step 0 records it in each
// project so the version behind a set of outputs can be recovered later.
//
// It is one of three places the version lives, alongside `VERSION=` and the `# Version:`
// header comment in ./PoolSeqFlow. dev/scripts/bump-version.sh updates all three, and
// .github/workflows/release.yml refuses to publish if any of them disagree.
manifest {
    name            = 'PoolSeqFlow'
    author          = 'Ozan L. Z. Kiratli'
    description     = 'Allele frequency analysis from pooled Illumina sequencing data'
    homePage        = 'https://ozankiratli.github.io/PoolSeqFlow/'
    mainScript      = 'poolseqflow.nf'
    license         = 'Apache-2.0'
    doi             = '10.5281/zenodo.19245611'
    version         = '2.2.0'
    // A bare `>=` is advisory: Nextflow warns and carries on -
    //   "WARN: Nextflow version 26.04.6 does not match version required by pipeline:
    //    >=26.04.0 -- execution will continue, but things might break!"
    // Prefixing it with `!` (`'!>=26.04.0'`) makes it abort instead. Left advisory
    // deliberately: the floor is where the pipeline is tested, not a version below which
    // it is known to break, so a run on a slightly older install is the operator's call.
    nextflowVersion = '>=26.04.0'
}

conda.enabled = true
docker.enabled = false

// Remove the work/ directory once the run completes successfully.
// `cleanup` is a plain option, not a config scope - do not add a `cleanup { }` block.
cleanup = true

process {
    errorStrategy = 'finish'  // Options: 'ignore', 'terminate', 'retry'
    maxRetries = 3
    maxErrors = -1  // -1 means unlimited; set to number to stop after N errors
    // Ceiling for what a task may request, taken from parameters.config so there is a
    // single place to size a run. This clamps oversized requests; it does not allocate.
    resourceLimits = [
        memory: params.memory,
        cpus: params.threads
    ]
}

// Add these settings to manage storage
dag {
    enabled = true
    file = "${params.dir.output.reports}/PoolSeqFlow_pipeline_dag.html"
    overwrite = true
}

// Add trace configuration
trace {
    enabled = true
    file = "${params.dir.output.reports}/PoolSeqFlow_pipeline_trace.txt"
    sep = '\t'
    raw = true
    fields = [
        'status',
        'task_id',
        'hash',
        'name',
        'exit',
        'start',
        'complete',
        'duration',
        'realtime',
        'cpus',
        'memory',
        '%cpu',
        '%mem',
        'attempt'
    ]
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.dir.output.reports}/PoolSeqFlow_pipeline_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.dir.output.reports}/PoolSeqFlow_pipeline_report.html"
    overwrite = true
}

// Work directory lives under mainDir so scratch and permanent storage are genuinely
// separate. A relative path here would resolve against the launch directory instead.
workDir = "${params.mainDir}/work"


env {
    PATH="${params.dir.bin}:\$PATH"
}