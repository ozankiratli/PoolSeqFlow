#!/bin/bash
#
# Version: 2.1.1
# Author : Ozan L. Z. Kiratli
# email  : ozankiratli@protonmail.com
#
# Wrapper script for PoolSeqFlow
# Usage: ./PoolSeqFlow {install|check|run|migrate_config|clean|reset|version|cite|uninstall}
#  install        - creates the conda environment using environment.yml, then verifies it
#  check          - verifies the installation: every tool resolves, helpers are
#                   executable, and parameters.config parses
#  run            - runs the pipeline; completed steps are detected and skipped
#                   automatically, so this both starts and resumes a run
#  migrate_config - carries an older parameters.config onto the current template
#  clean          - cleans the Nextflow work directory
#  reset          - cleans the Nextflow work directory and deletes all output files. (Use with caution!)
#  cite           - prints how to cite this copy, and which DOI to use
#  uninstall      - removes the conda environment

set -e
eval "$(conda shell.bash hook)"

VERSION="2.1.1"

# Zenodo concept DOI - the software as a whole. It always resolves to the newest
# release and never changes, which is why it is the one on the badge and in the
# docs. Every release ALSO gets its own version DOI, and that is the one a paper
# should carry, because results depend on the version. `cite` says so.
CONCEPT_DOI="10.5281/zenodo.19245611"

usage() {
    echo "Usage: $0 {install|check|run|migrate_config|clean|reset|version|cite|uninstall}"
    exit 1
}

# Resolve a setting through Nextflow rather than parsing parameters.config by hand -
# values are interpolated (workDir is built from mainDir), so text matching gets them
# wrong. Requires the conda environment to be active.
nf_config_value() {
    nextflow config -flat 2>/dev/null | sed -n "s|^$1 = ||p" | head -1 | tr -d "'\""
}

if [ "$#" -ne 1 ]; then
    usage
fi

COMMAND=$1
ENV_NAME="PoolSeqFlow"   # Change this to match your conda environment name
ENV_FILE="install/environment.yml"  # Make sure this file exists in the project root

case $COMMAND in
    install)
        echo "Installing conda environment..."
        if conda env list | grep -q "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' already exists."
        else
            conda env create -f "$ENV_FILE"
        fi
        echo "Installation complete."
        echo
        # An environment that was created but is missing a tool is not an install.
        # Verify before reporting success: a tool that is absent here would
        # otherwise surface partway through a run, hours in. `set -e` means a
        # failed check fails the install.
        conda activate "$ENV_NAME"
        bash install/check_install.sh
        ;;

    check)
        if ! conda env list | grep -q "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' does not exist. Run './$(basename "$0") install' first." >&2
            exit 1
        fi
        conda activate "$ENV_NAME"
        bash install/check_install.sh
        ;;
    run|resume)
        # PoolSeqFlow resumes through its own filesystem checks: every step looks for
        # its outputs in projectDir and skips itself if they are already there. Nextflow's
        # -resume is not used - it depends on the work/ task directories, which
        # `cleanup = true` deletes on completion. Use `reset` to force a full re-run.
        if [ "$COMMAND" = "resume" ]; then
            echo "Note: 'resume' is deprecated - 'run' already resumes automatically."
        fi
        echo "Running pipeline..."
        conda activate "$ENV_NAME"
        nextflow run poolseqflow.nf
        wait
        conda deactivate
        ;;
    migrate_config)
        MIGRATE="bin/config_migrate.sh"
        [ -f "$MIGRATE" ] || { echo "ERROR: $MIGRATE not found." >&2; exit 1; }
        echo "-------------------------------------------------------------------------"
        echo " WARNING: this rewrites parameters.config."
        echo ""
        echo " Migration is a convenience, not a guarantee. It carries across settings"
        echo " whose parameter still exists and has the same meaning. It cannot know"
        echo " about a parameter whose behaviour changed in a way that still looks"
        echo " like a plain value, so a migrated file can be silently wrong."
        echo ""
        echo " Read the report below, then diff your file against the template:"
        echo "     diff parameters.config parameters.config.template"
        echo ""
        echo " Every release adds parameters, so starting from the template and"
        echo " re-entering your settings by hand is often the safer choice:"
        echo "     cp parameters.config.template parameters.config"
        echo "-------------------------------------------------------------------------"
        echo ""
        bash "$MIGRATE"
        echo ""
        echo "Now compare the result against the template before running:"
        echo "    diff parameters.config parameters.config.template"
        ;;
    clean)
        echo "Cleaning Nextflow work directory..."
        conda activate "$ENV_NAME"
        WORKDIR=$(nf_config_value workDir)
        nextflow clean -f || true
        wait
        conda deactivate
        wait
        if [ -n "$WORKDIR" ]; then
            echo "Removing $WORKDIR and log files"
            rm -rf "$WORKDIR"
        else
            echo "WARNING: could not resolve workDir; leaving it in place." >&2
        fi
        rm -rf .nextflow*
        echo "Cleaned."
        ;;
    reset)
        conda activate "$ENV_NAME"
        WORKDIR=$(nf_config_value workDir)
        STORAGE=$(nf_config_value params.projectDir)
        DATADIR=$(nf_config_value params.dir.data)
        conda deactivate
        if [ -z "$STORAGE" ]; then
            echo "ERROR: could not resolve params.projectDir - is parameters.config present?" >&2
            exit 1
        fi
        echo ""
        echo "This permanently deletes:"
        echo "    $STORAGE/Output      - every result produced so far"
        echo "    $STORAGE/Reports"
        echo "    $STORAGE/Logs"
        echo "    $STORAGE/Reference   - indices and the SnpEff database"
        echo "    $STORAGE/.poolseqflow_params"
        echo "    $STORAGE/.poolseqflow_rgtags"
        [ -n "$WORKDIR" ] && echo "    $WORKDIR"
        echo ""
        echo "Your raw sequencing data in $DATADIR is not touched."
        echo ""
        printf 'Type DELETE_MY_ANALYSIS to confirm: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was deleted."
            exit 1
        fi
        if [ "$CONFIRM" != "DELETE_MY_ANALYSIS" ]; then
            echo "Aborted - nothing was deleted."
            exit 1
        fi
        echo "Resetting pipeline..."
        rm -rf .nextflow*
        if [ -n "$WORKDIR" ]; then rm -rf "$WORKDIR"; fi
        rm -rf "$STORAGE"/Reports "$STORAGE"/Logs "$STORAGE"/Output \
               "$STORAGE"/Reference "$STORAGE"/PoolSeqFlow_*
        # These record the parameters and RG tags behind outputs that no longer exist;
        # leaving them would make the next run fail its checks for no reason.
        rm -f "$STORAGE"/.poolseqflow_params "$STORAGE"/.poolseqflow_rgtags
        echo "Reset complete."
        ;;
    version)
        echo "PoolSeqFlow"
        echo "v$VERSION"
        ;;

    cite)
        cat <<EOF
PoolSeqFlow v$VERSION
Ozan L. Z. Kiratli

Cite the version you actually ran, not the newest one.
--------------------------------------------------------------------
Zenodo mints a separate DOI for every release, and results depend on
which release produced them - filters, defaults and parameter names
have all changed between versions. A paper that cites the current
release for numbers produced by an older one is describing a method
it did not use.

This copy is v$VERSION. To get its DOI, open the all-versions record
below and pick v$VERSION from the "Versions" list:

    https://doi.org/$CONCEPT_DOI

Then replace the DOI in the entries below with that one.

Reference
--------------------------------------------------------------------
Kiratli, O. L. Z. (2026). PoolSeqFlow: A Nextflow pipeline for allele
frequency analysis from pooled Illumina sequencing data (Version
v$VERSION) [Computer software]. https://doi.org/$CONCEPT_DOI

BibTeX
--------------------------------------------------------------------
@software{kiratli_poolseqflow,
  author  = {Kiratli, Ozan L. Z.},
  title   = {PoolSeqFlow: A Nextflow pipeline for allele frequency
             analysis from pooled Illumina sequencing data},
  version = {v$VERSION},
  year    = {2026},
  doi     = {$CONCEPT_DOI},
  url     = {https://github.com/ozankiratli/PoolSeqFlow}
}

$CONCEPT_DOI is the all-versions DOI: it always resolves to the
newest release. Use it when referring to the software in general, and
a version DOI when reporting results.
EOF
        ;;
    uninstall)
        echo "Uninstalling conda environment..."
        conda deactivate
        conda env remove -n "$ENV_NAME"
        ;;
    *)
        usage
        ;;
esac