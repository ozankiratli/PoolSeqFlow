#!/bin/bash
#
# Version: 2.2.0
# Author : Ozan L. Z. Kiratli
# email  : ozankiratli@protonmail.com
#
# Wrapper script for PoolSeqFlow
# Usage: ./PoolSeqFlow {install|check|run|migrate_config|clean|reset|version|cite|list|uninstall|uninstall_all}
#  install        - creates the conda environment using environment.yml, then verifies it
#  check          - verifies the installation: every tool resolves, helpers are
#                   executable, and parameters.config parses
#  run            - runs the pipeline; completed steps are detected and skipped
#                   automatically, so this both starts and resumes a run
#  migrate_config - carries an older parameters.config onto the current template
#  clean          - cleans the Nextflow work directory
#  reset          - cleans the Nextflow work directory and deletes all output files. (Use with caution!)
#  version        - prints the version of this copy
#  cite           - prints how to cite this copy, and which DOI to use
#  list           - lists the PoolSeqFlow conda environments installed on this machine
#  uninstall      - removes this version's conda environment
#  uninstall_all  - removes every PoolSeqFlow conda environment, after confirmation
#
# The conda environment is named after the release (PoolSeqFlow-<version>), so each version
# installs and runs against its own pinned tool set.

set -e
eval "$(conda shell.bash hook)"

VERSION="2.2.0"

# Zenodo concept DOI - the software as a whole. It always resolves to the newest
# release and never changes, which is why it is the one on the badge and in the
# docs. Every release ALSO gets its own version DOI, and that is the one a paper
# should carry, because results depend on the version. `cite` says so.
CONCEPT_DOI="10.5281/zenodo.19245611"

usage() {
    echo "Usage: $0 {install|check|run|migrate_config|clean|reset|version|cite|list|uninstall|uninstall_all}"
    exit 1
}

# `conda env list` prints "<name>  [*]  <path>" per environment, so grepping the whole
# line for the name also matches any OTHER environment whose path happens to contain it.
# That is not hypothetical here: the repository directory is itself called PoolSeqFlow,
# so an environment created underneath it matches. Compare the name column only, and
# compare it whole (-x) and literally (-F) so a name containing '.' or '+' still works.
env_exists() {
    conda env list | awk '{print $1}' | grep -qxF "$1"
}

# Every PoolSeqFlow environment on this machine: the versioned ones and the single
# unversioned name older releases used. `|| true` because grep exits 1 when nothing
# matches, and this script runs under `set -e`.
poolseqflow_envs() {
    conda env list | awk '{print $1}' | grep -E '^PoolSeqFlow(-.+)?$' | sort || true
}

# Every PoolSeqFlow environment except this version's own and the legacy unversioned one.
other_version_envs() {
    poolseqflow_envs | grep -vxF "$ENV_NAME" | grep -vxF "$LEGACY_ENV" || true
}

# Activate this version's environment, or explain what to do about its absence.
#
# This deliberately never falls back to another version's environment. The pinned tool
# versions are part of what produced a result, so running this code against a different
# release's tools would leave `.poolseqflow_versions` recording a version that did not
# actually produce the outputs.
require_env() {
    if env_exists "$ENV_NAME"; then
        conda activate "$ENV_NAME"
        return 0
    fi

    echo "ERROR: conda environment '$ENV_NAME' not found." >&2
    echo "" >&2
    if env_exists "$LEGACY_ENV"; then
        echo "An environment called '$LEGACY_ENV' does exist. That is an install from a" >&2
        echo "release that kept every version in one environment. Environments are named" >&2
        echo "after the version now, so this copy does not use it." >&2
        echo "" >&2
    fi
    OTHERS=$(other_version_envs)
    if [ -n "$OTHERS" ]; then
        echo "Environments for other versions are installed:" >&2
        echo "$OTHERS" | sed 's/^/    /' >&2
        echo "" >&2
    fi
    echo "Install this version's environment with:" >&2
    echo "    ./$(basename "$0") install" >&2
    exit 1
}

# Report the other PoolSeqFlow environments present, if any. An operator who has upgraded a
# few times should be told they are accumulating rather than discover it from a full disk.
report_other_envs() {
    OTHERS=$(poolseqflow_envs | grep -vxF "$ENV_NAME" || true)
    [ -n "$OTHERS" ] || return 0
    echo "Other PoolSeqFlow environments on this machine:"
    # Annotated the same way `list` does. The legacy name matches poolseqflow_envs too, and
    # calling it "a different version" would be wrong - it predates versioned names.
    for env in $OTHERS; do
        if [ "$env" = "$LEGACY_ENV" ]; then
            printf '    %-24s unversioned - predates per-version environments\n' "$env"
        else
            printf '    %s\n' "$env"
        fi
    done
    echo ""
    echo "None of them is used by this copy. Keep the ones whose results you still need to"
    echo "reproduce; remove the rest:"
    printf '    %-32s %s\n' "conda env remove -n <name>" "one environment"
    printf '    %-32s %s\n' "./$(basename "$0") uninstall_all" "every PoolSeqFlow environment"
    echo ""
}

# Resolve a setting through Nextflow rather than parsing parameters.config by hand -
# values are interpolated (workDir is built from mainDir), so text matching gets them
# wrong. Requires the conda environment to be active.
nf_config_value() {
    nextflow config -flat 2>/dev/null | sed -n "s|^$1 = ||p" | head -1 | tr -d "'\""
}

if [ "$#" -ne 1 ]; then
    usage
fi

COMMAND=$1

# The environment is named after the release it belongs to, and the name is derived from
# VERSION above so a version bump carries it automatically.
#
# Earlier releases all shared one environment called "PoolSeqFlow". That made upgrading
# quietly wrong: `install` found an environment of that name already present, did nothing,
# and the new release then ran against the previous release's pinned tools while
# `.poolseqflow_versions` recorded the new one. A versioned name makes the tool set behind
# a result identifiable.
#
# The cost is smaller than `du` suggests but not negligible. Conda hardlinks most package
# files from its shared cache, so environments overlap on disk. Measured on this
# environment: 1000 MB total, of which 696 MB (90% of files) is hardlinked and shared, and
# 304 MB (10% of files) is genuinely per-environment. So a second version costs roughly
# 300 MB even where the packages match, plus the full size of anything whose version
# differs. Counting files rather than bytes makes the sharing look better than it is.
ENV_NAME="PoolSeqFlow-${VERSION}"

# What an install from before the change above is called. Detected so the error messages
# can say so; never activated.
LEGACY_ENV="PoolSeqFlow"

ENV_FILE="install/environment.yml"  # Make sure this file exists in the project root

case $COMMAND in
    install)
        echo "Installing conda environment '$ENV_NAME'..."
        if env_exists "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' already exists."
        else
            # -n overrides the `name:` key inside environment.yml. Without it conda takes
            # the name from that key and every release lands in the same environment again,
            # which is the behaviour the versioned name exists to end.
            conda env create -n "$ENV_NAME" -f "$ENV_FILE"
        fi
        echo "Installation complete."
        echo
        report_other_envs
        # An environment that was created but is missing a tool is not an install.
        # Verify before reporting success: a tool that is absent here would
        # otherwise surface partway through a run, hours in. `set -e` means a
        # failed check fails the install.
        conda activate "$ENV_NAME"
        bash install/check_install.sh
        ;;

    check)
        require_env
        bash install/check_install.sh
        ;;
    run|resume)
        # PoolSeqFlow resumes through its own filesystem checks: every step looks for
        # its outputs in projectDir and skips itself if they are already there. Nextflow's
        # -resume is not used - it depends on the work/ task directories, which
        # `cleanup = true` deletes on completion. Use `reset` to force a full re-run.
        if [ "$COMMAND" = "resume" ]; then
            echo "Note: 'resume' is deprecated - 'run' already resumes automatically."
        fi
        echo "Running pipeline..."
        require_env
        nextflow run poolseqflow.nf
        wait
        conda deactivate
        ;;
    migrate_config)
        MIGRATE="bin/config_migrate.sh"
        [ -f "$MIGRATE" ] || { echo "ERROR: $MIGRATE not found." >&2; exit 1; }
        echo "-------------------------------------------------------------------------"
        echo " WARNING: this rewrites parameters.config."
        echo ""
        echo " Migration is a convenience, not a guarantee. It carries across settings"
        echo " whose parameter still exists and has the same meaning. It cannot know"
        echo " about a parameter whose behaviour changed in a way that still looks"
        echo " like a plain value, so a migrated file can be silently wrong."
        echo ""
        echo " Read the report below, then diff your file against the template:"
        echo "     diff parameters.config parameters.config.template"
        echo ""
        echo " Every release adds parameters, so starting from the template and"
        echo " re-entering your settings by hand is often the safer choice:"
        echo "     cp parameters.config.template parameters.config"
        echo "-------------------------------------------------------------------------"
        echo ""
        bash "$MIGRATE"
        echo ""
        echo "Now compare the result against the template before running:"
        echo "    diff parameters.config parameters.config.template"
        ;;
    clean)
        echo "Cleaning Nextflow work directory..."
        require_env
        WORKDIR=$(nf_config_value workDir)
        nextflow clean -f || true
        wait
        conda deactivate
        wait
        if [ -n "$WORKDIR" ]; then
            echo "Removing $WORKDIR and log files"
            rm -rf "$WORKDIR"
        else
            echo "WARNING: could not resolve workDir; leaving it in place." >&2
        fi
        rm -rf .nextflow*
        echo "Cleaned."
        ;;
    reset)
        require_env
        WORKDIR=$(nf_config_value workDir)
        STORAGE=$(nf_config_value params.projectDir)
        DATADIR=$(nf_config_value params.dir.data)
        conda deactivate
        if [ -z "$STORAGE" ]; then
            echo "ERROR: could not resolve params.projectDir - is parameters.config present?" >&2
            exit 1
        fi
        echo ""
        echo "This permanently deletes:"
        echo "    $STORAGE/Output      - every result produced so far"
        echo "    $STORAGE/Reports     - only if a pre-2.1 version put reports here"
        echo "    $STORAGE/Logs"
        echo "    $STORAGE/Reference   - indices and the SnpEff database"
        echo "    $STORAGE/.poolseqflow_params"
        echo "    $STORAGE/.poolseqflow_rgtags"
        echo "    $STORAGE/.poolseqflow_versions"
        echo "    $(pwd)/.nextflow*    - Nextflow's own history and cache"
        [ -n "$WORKDIR" ] && echo "    $WORKDIR"
        echo ""
        echo "Your raw sequencing data in $DATADIR is not touched."
        echo ""
        printf 'Type DELETE_MY_ANALYSIS to confirm: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was deleted."
            exit 1
        fi
        if [ "$CONFIRM" != "DELETE_MY_ANALYSIS" ]; then
            echo "Aborted - nothing was deleted."
            exit 1
        fi
        echo "Resetting pipeline..."
        rm -rf .nextflow*
        if [ -n "$WORKDIR" ]; then rm -rf "$WORKDIR"; fi
        # `$STORAGE/Reports` only exists for projects created before 2.1.0, when reports
        # were written outside Output/. Harmless when absent, so it stays.
        #
        # `$STORAGE/PoolSeqFlow_*` used to be removed here too. It was dropped: the
        # PoolSeqFlow_pipeline_{dag,trace,timeline,report} files have gone to
        # ${params.dir.output.reports} in every release since 1.0.0, never to projectDir
        # itself, so the glob never matched anything this pipeline created - it could only
        # ever have deleted a user's own file or directory that happened to start with
        # "PoolSeqFlow_", undisclosed and with rm -rf.
        rm -rf "$STORAGE"/Reports "$STORAGE"/Logs "$STORAGE"/Output \
               "$STORAGE"/Reference
        # These record the parameters, RG tags and pipeline versions behind outputs that
        # no longer exist; leaving them would make the next run fail its checks for no
        # reason, and would attribute fresh results to an earlier release.
        rm -f "$STORAGE"/.poolseqflow_params "$STORAGE"/.poolseqflow_rgtags \
              "$STORAGE"/.poolseqflow_versions
        echo "Reset complete."
        ;;
    list)
        INSTALLED=$(poolseqflow_envs)
        if [ -z "$INSTALLED" ]; then
            echo "No PoolSeqFlow conda environments are installed."
            echo "Install this version's with:  ./$(basename "$0") install"
            exit 0
        fi
        echo "PoolSeqFlow conda environments:"
        for env in $INSTALLED; do
            if [ "$env" = "$ENV_NAME" ]; then
                printf '  * %-24s this copy (v%s)\n' "$env" "$VERSION"
            elif [ "$env" = "$LEGACY_ENV" ]; then
                printf '    %-24s unversioned - predates per-version environments\n' "$env"
            else
                printf '    %s\n' "$env"
            fi
        done
        echo ""
        if ! env_exists "$ENV_NAME"; then
            echo "This copy is v$VERSION and runs only against '$ENV_NAME',"
            echo "which is not installed. Install it with:"
            echo "    ./$(basename "$0") install"
            echo ""
        fi
        echo "Remove one environment:   conda env remove -n <name>"
        echo "Remove all of them:       ./$(basename "$0") uninstall_all"
        ;;

    version)
        echo "PoolSeqFlow"
        echo "v$VERSION"
        ;;

    cite)
        cat <<EOF
PoolSeqFlow v$VERSION
Ozan L. Z. Kiratli

Cite the version you actually ran, not the newest one.
--------------------------------------------------------------------
Zenodo mints a separate DOI for every release, and results depend on
which release produced them - filters, defaults and parameter names
have all changed between versions. A paper that cites the current
release for numbers produced by an older one is describing a method
it did not use.

This copy is v$VERSION. To get its DOI, open the all-versions record
below and pick v$VERSION from the "Versions" list:

    https://doi.org/$CONCEPT_DOI

Then replace the DOI in the entries below with that one.

Reference
--------------------------------------------------------------------
Kiratli, O. L. Z. (2026). PoolSeqFlow: A Nextflow pipeline for allele
frequency analysis from pooled Illumina sequencing data (Version
v$VERSION) [Computer software]. https://doi.org/$CONCEPT_DOI

BibTeX
--------------------------------------------------------------------
@software{kiratli_poolseqflow,
  author  = {Kiratli, Ozan L. Z.},
  title   = {PoolSeqFlow: A Nextflow pipeline for allele frequency
             analysis from pooled Illumina sequencing data},
  version = {v$VERSION},
  year    = {2026},
  doi     = {$CONCEPT_DOI},
  url     = {https://github.com/ozankiratli/PoolSeqFlow}
}

$CONCEPT_DOI is the all-versions DOI: it always resolves to the
newest release. Use it when referring to the software in general, and
a version DOI when reporting results.
EOF
        ;;
    uninstall)
        # Checked rather than attempted: `conda env remove` on an absent environment exits
        # non-zero, and under `set -e` that surfaced as a raw conda error with no indication
        # of which environments do exist.
        if ! env_exists "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' is not installed." >&2
            INSTALLED=$(poolseqflow_envs)
            if [ -n "$INSTALLED" ]; then
                echo "" >&2
                echo "PoolSeqFlow environments that are installed:" >&2
                echo "$INSTALLED" | sed 's/^/    /' >&2
                echo "" >&2
                echo "Remove one with: conda env remove -n <name>" >&2
            fi
            exit 1
        fi
        echo "Uninstalling conda environment '$ENV_NAME'..."
        conda deactivate
        conda env remove -n "$ENV_NAME"
        ;;

    uninstall_all)
        # A separate subcommand rather than `uninstall all`, so the wrapper keeps taking
        # exactly one argument - the contract parameters.config.template documents.
        INSTALLED=$(poolseqflow_envs)
        if [ -z "$INSTALLED" ]; then
            echo "No PoolSeqFlow conda environments are installed. Nothing to do."
            exit 0
        fi
        echo ""
        echo "This removes every PoolSeqFlow conda environment on this machine:"
        echo "$INSTALLED" | sed 's/^/    /'
        echo ""
        echo "Only the environments go. Your project data, outputs, logs and"
        echo "parameters.config are untouched - none of them live in a conda environment."
        echo "Reinstall this version afterwards with:"
        echo "    ./$(basename "$0") install"
        echo ""
        echo "Removing an environment means results produced with that version can no"
        echo "longer be reproduced without reinstalling it."
        echo ""
        printf 'Remove them? [y/N]: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was removed."
            exit 1
        fi
        case "$CONFIRM" in
            y|Y|yes|YES|Yes) ;;
            *) echo "Aborted - nothing was removed."; exit 1 ;;
        esac
        # Whichever one is active has to be stepped out of before it can be removed. It may
        # be that none is, so a failure here is not interesting.
        conda deactivate 2>/dev/null || true
        # A plain `for` rather than `... | while read`: a piped loop runs in a subshell, so
        # a failure inside it would not stop the script the way `set -e` should. Environment
        # names cannot contain whitespace - `conda env list` is column-separated and
        # poolseqflow_envs takes the first field - so word splitting is safe here.
        for env in $INSTALLED; do
            echo "Removing $env..."
            conda env remove -n "$env" -y
        done
        echo ""
        echo "All PoolSeqFlow environments removed."
        ;;
    *)
        usage
        ;;
esac