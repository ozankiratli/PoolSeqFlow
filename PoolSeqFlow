#!/bin/bash
#
# Version: 2.2.0
# Author : Ozan L. Z. Kiratli
# email  : ozankiratli@protonmail.com
#
# Wrapper script for PoolSeqFlow
# Usage: ./PoolSeqFlow {install|check|run|migrate_config|clean|reset|version|cite|list|uninstall|uninstall_all}
#  install        - installs this release: creates its conda environment, copies the
#                   pipeline to <prefix>/opt/PoolSeqFlow-<version>, puts wrappers in
#                   <prefix>/bin, then verifies the result
#  check          - verifies the installation: every tool resolves, helpers are
#                   executable, and parameters.config parses
#  run            - runs the pipeline; completed steps are detected and skipped
#                   automatically, so this both starts and resumes a run
#  migrate_config - carries an older parameters.config onto the current template
#  clean          - cleans the Nextflow work directory
#  reset          - cleans the Nextflow work directory and deletes all output files. (Use with caution!)
#  version        - prints the version of this copy
#  cite           - prints how to cite this copy, and which DOI to use
#  list           - lists the installed pipelines and conda environments on this machine
#  uninstall      - removes this version's conda environment and installed pipeline
#  uninstall_all  - removes every PoolSeqFlow environment and installation, after confirmation
#
# Each subcommand takes no arguments of its own: the wrapper accepts exactly one word and
# rejects anything else. Two environment variables adjust it instead:
#
#  POOLSEQFLOW_PREFIX - where `install` puts things, and where `list` and `uninstall` look.
#                       Defaults to ~/.local, or to the prefix an installed copy already
#                       lives in, so it usually need not be set at all.
#  POOLSEQFLOW_HOME   - the pipeline to use, overriding the copy this wrapper belongs to.
#                       For running a checkout without installing it.
#
# The conda environment is named after the release (PoolSeqFlow-<version>), and the pipeline
# is installed under the same name, so each version runs against its own pinned tool set and
# an old result stays reproducible.

set -e
eval "$(conda shell.bash hook)"

VERSION="2.2.0"

# Zenodo concept DOI - the software as a whole. It always resolves to the newest
# release and never changes, which is why it is the one on the badge and in the
# docs. Every release ALSO gets its own version DOI, and that is the one a paper
# should carry, because results depend on the version. `cite` says so.
CONCEPT_DOI="10.5281/zenodo.19245611"

usage() {
    echo "Usage: $0 {install|check|run|migrate_config|clean|reset|version|cite|list|uninstall|uninstall_all}"
    exit 1
}

# Stamped by `install` into the copy it deploys; empty in the source tree and in a checkout
# run in place. Written rather than derived because the installed wrapper is reached through a
# symlink on PATH, and resolving a symlink back to its target is the one step in all of this
# that varies between systems - `readlink -f` is GNU, and BSD readlink has no -f at all.
#
# It is a default, not an override: POOLSEQFLOW_HOME still wins, so a developer can point an
# installed wrapper at a checkout without reinstalling.
POOLSEQFLOW_INSTALLED_HOME=""

# Where this copy of PoolSeqFlow lives: the pipeline, scripts/ and the bin/ helpers. It is
# not the project you are running - that is the directory you are standing in.
#
# Three sources, in order: the environment, so a checkout can be pointed at explicitly; the
# stamp above, for an installed copy; and failing both, this script's own resolved path, which
# is what makes a plain `./PoolSeqFlow` in a clone work with no setup at all.
if [ -n "${POOLSEQFLOW_HOME:-}" ]; then
    INSTALL="$POOLSEQFLOW_HOME"
elif [ -n "$POOLSEQFLOW_INSTALLED_HOME" ]; then
    INSTALL="$POOLSEQFLOW_INSTALLED_HOME"
else
    INSTALL=$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)
fi
export POOLSEQFLOW_HOME="$INSTALL"

# Confirm the payload is actually there, for the subcommands that need it.
#
# Checked lazily rather than at startup: `version`, `cite`, `list`, `uninstall` and
# `uninstall_all` are answerable from this script alone, and refusing them because the
# pipeline is missing would take away the commands most likely to be wanted when an
# installation is broken.
require_install() {
    [ -f "$INSTALL/poolseqflow.nf" ] && return 0
    echo "ERROR: cannot find the PoolSeqFlow installation." >&2
    echo "  Looked in: $INSTALL" >&2
    echo "  Expected to find poolseqflow.nf there, alongside scripts/ and bin/." >&2
    echo "  Set POOLSEQFLOW_HOME to the directory holding it." >&2
    exit 1
}

# Refuse early when the current directory is not a project.
#
# Checked here rather than left to Nextflow: a missing include surfaces as
# "ERROR ~ Unable to parse config file" with the real cause - a NullPointerException -
# only in .nextflow.log, which is not a message anyone can act on.
require_project_config() {
    [ -f parameters.config ] && return 0
    echo "ERROR: no parameters.config in $(pwd)" >&2
    echo "" >&2
    echo "PoolSeqFlow runs in your project's directory, not in its own installation." >&2
    echo "Create the project, put a parameters.config in it, and run from there:" >&2
    echo "    mkdir -p /path/to/project" >&2
    echo "    cp $INSTALL/parameters.config.template /path/to/project/parameters.config" >&2
    echo "    cd /path/to/project" >&2
    echo "    $(basename "$0") $COMMAND" >&2
    exit 1
}

# What an installation consists of: exactly the set `git archive` puts in a release tarball,
# which .gitattributes defines by exclusion. Installing from a clone and installing from a
# download therefore deploy identical trees. test/suites/00_static.sh checks the two agree, so
# a file added to the release without being added here fails a test rather than going missing
# from every install.
PAYLOAD_ITEMS="PoolSeqFlow poolseqflow.nf nextflow.config scripts bin install \
parameters.config.template RGTags.csv.template multi-run.csv.example \
README.md CHANGELOG.md LICENSE"

# Where installations live. POOLSEQFLOW_PREFIX chooses; ~/.local by default, because it needs
# no privileges and is already on PATH for many users.
#
# An environment variable rather than a --prefix flag: the wrapper takes exactly one
# subcommand and rejects everything else, and that contract is worth keeping. `make install
# PREFIX=...` has the same shape.
#
# When neither is given, an installed wrapper works it out from its own stamp. A payload
# always sits at <prefix>/opt/PoolSeqFlow-<version>, so two components back is the prefix.
# That is what makes `list` and `uninstall` correct without the user having to remember which
# prefix they installed into - otherwise both would look under ~/.local, find nothing, and
# report that nothing is installed while several copies sat elsewhere.
#
# A wrapper run from a clone has no stamp and falls back to the default. That is the case
# where a prefix is being chosen rather than recalled, so there is nothing to get wrong.
install_prefix() {
    if [ -n "${POOLSEQFLOW_PREFIX:-}" ]; then
        printf '%s' "$POOLSEQFLOW_PREFIX"
    elif [ -n "$POOLSEQFLOW_INSTALLED_HOME" ]; then
        printf '%s' "$(dirname "$(dirname "$POOLSEQFLOW_INSTALLED_HOME")")"
    else
        printf '%s' "$HOME/.local"
    fi
}

# Every version installed under a prefix, oldest first. Sorted by version rather than by
# mtime: reinstalling an older release must not make it the newest.
installed_payload_versions() {
    local prefix="$1" d
    for d in "$prefix"/opt/PoolSeqFlow-*; do
        [ -d "$d" ] || continue
        printf '%s\n' "${d##*/PoolSeqFlow-}"
    done | sort -V
}

newest_installed_version() {
    installed_payload_versions "$1" | tail -1
}

# Remove one version's payload and its wrapper, then re-point the plain wrapper at whatever
# is left - or remove it, if nothing is. A dangling `PoolSeqFlow` would be a command on PATH
# with no code behind it, which fails far less clearly than its absence.
#
# Removing the payload you are currently running from is safe on Linux: the shell holds the
# script open, and unlinking an open file keeps its contents readable until the last close.
# Verified rather than assumed - see the self-uninstall case in test/suites/20_launcher.sh.
remove_payload() {
    local version="$1" prefix dest bindir newest
    prefix=$(install_prefix)
    dest="$prefix/opt/PoolSeqFlow-${version}"
    bindir="$prefix/bin"
    [ -d "$dest" ] || return 1

    rm -rf "$dest"
    rm -f "$bindir/PoolSeqFlow-${version}"
    echo "Removed $dest"
    newest=$(newest_installed_version "$prefix")
    if [ -n "$newest" ]; then
        ln -sfn "$prefix/opt/PoolSeqFlow-${newest}/PoolSeqFlow" "$bindir/PoolSeqFlow"
        echo "  $bindir/PoolSeqFlow now points at v$newest"
    else
        rm -f "$bindir/PoolSeqFlow"
        echo "  $bindir/PoolSeqFlow removed - no installed versions remain"
    fi
    return 0
}

# Copy the runtime to $PREFIX/opt/PoolSeqFlow-<version> and put wrappers on PATH.
#
# $PREFIX/bin gets one symlink per version plus a plain `PoolSeqFlow` pointing at the newest
# installed, so a bare `PoolSeqFlow run` means the newest and any specific version stays
# reachable by name. Both are symlinks into the versioned payload, so removing a version
# removes its wrapper's target rather than leaving a working command with no code behind it.
deploy_payload() {
    local prefix dest bindir here item newest
    prefix=$(install_prefix)
    dest="$prefix/opt/PoolSeqFlow-${VERSION}"
    bindir="$prefix/bin"
    here=$(cd "$INSTALL" && pwd -P)

    if [ "$here" = "$dest" ]; then
        echo "The pipeline is already installed at $dest."
    else
        for item in $PAYLOAD_ITEMS; do
            [ -e "$INSTALL/$item" ] || {
                echo "ERROR: $INSTALL/$item is missing." >&2
                echo "  This copy is incomplete, so installing from it would deploy a broken tree." >&2
                exit 1
            }
        done
        echo "Installing the pipeline into $dest..."
        rm -rf "$dest"
        mkdir -p "$dest"
        for item in $PAYLOAD_ITEMS; do
            cp -r "$INSTALL/$item" "$dest"/
        done
        # Stamp the copy with its own location. See POOLSEQFLOW_INSTALLED_HOME above.
        sed -i "s|^POOLSEQFLOW_INSTALLED_HOME=\"\"$|POOLSEQFLOW_INSTALLED_HOME=\"$dest\"|" \
            "$dest/PoolSeqFlow"
        grep -q "^POOLSEQFLOW_INSTALLED_HOME=\"$dest\"$" "$dest/PoolSeqFlow" || {
            echo "ERROR: could not stamp the installed wrapper with its location." >&2
            echo "  The placeholder line in PoolSeqFlow has probably changed." >&2
            exit 1
        }
        chmod +x "$dest/PoolSeqFlow"
    fi

    mkdir -p "$bindir"
    ln -sfn "$dest/PoolSeqFlow" "$bindir/PoolSeqFlow-${VERSION}"
    newest=$(newest_installed_version "$prefix")
    ln -sfn "$prefix/opt/PoolSeqFlow-${newest}/PoolSeqFlow" "$bindir/PoolSeqFlow"

    echo ""
    echo "Installed:"
    echo "    $dest"
    echo "    $bindir/PoolSeqFlow-${VERSION}"
    printf '    %-40s -> v%s, the newest installed\n' "$bindir/PoolSeqFlow" "$newest"
    echo ""
    case ":$PATH:" in
        *":$bindir:"*)
            echo "$bindir is on your PATH, so both commands work from anywhere."
            ;;
        *)
            echo "$bindir is NOT on your PATH, so neither command will be found by name yet."
            echo "Add it - in ~/.bashrc, ~/.zshrc or wherever your shell reads:"
            echo ""
            echo "    export PATH=\"$bindir:\$PATH\""
            echo ""
            echo "Until then, call the wrapper by its full path."
            ;;
    esac
    echo ""
}

# `conda env list` prints "<name>  [*]  <path>" per environment, so grepping the whole
# line for the name also matches any OTHER environment whose path happens to contain it.
# That is not hypothetical here: the repository directory is itself called PoolSeqFlow,
# so an environment created underneath it matches. Compare the name column only, and
# compare it whole (-x) and literally (-F) so a name containing '.' or '+' still works.
env_exists() {
    conda env list | awk '{print $1}' | grep -qxF "$1"
}

# Every PoolSeqFlow environment on this machine: the versioned ones and the single
# unversioned name older releases used. `|| true` because grep exits 1 when nothing
# matches, and this script runs under `set -e`.
poolseqflow_envs() {
    conda env list | awk '{print $1}' | grep -E '^PoolSeqFlow(-.+)?$' | sort || true
}

# Every PoolSeqFlow environment except this version's own and the legacy unversioned one.
other_version_envs() {
    poolseqflow_envs | grep -vxF "$ENV_NAME" | grep -vxF "$LEGACY_ENV" || true
}

# Activate this version's environment, or explain what to do about its absence.
#
# This deliberately never falls back to another version's environment. The pinned tool
# versions are part of what produced a result, so running this code against a different
# release's tools would leave `.poolseqflow_versions` recording a version that did not
# actually produce the outputs.
require_env() {
    if env_exists "$ENV_NAME"; then
        conda activate "$ENV_NAME"
        return 0
    fi

    echo "ERROR: conda environment '$ENV_NAME' not found." >&2
    echo "" >&2
    if env_exists "$LEGACY_ENV"; then
        echo "An environment called '$LEGACY_ENV' does exist. That is an install from a" >&2
        echo "release that kept every version in one environment. Environments are named" >&2
        echo "after the version now, so this copy does not use it." >&2
        echo "" >&2
    fi
    OTHERS=$(other_version_envs)
    if [ -n "$OTHERS" ]; then
        echo "Environments for other versions are installed:" >&2
        echo "$OTHERS" | sed 's/^/    /' >&2
        echo "" >&2
    fi
    echo "Install this version's environment with:" >&2
    echo "    ./$(basename "$0") install" >&2
    exit 1
}

# Report the other PoolSeqFlow environments present, if any. An operator who has upgraded a
# few times should be told they are accumulating rather than discover it from a full disk.
report_other_envs() {
    OTHERS=$(poolseqflow_envs | grep -vxF "$ENV_NAME" || true)
    [ -n "$OTHERS" ] || return 0
    echo "Other PoolSeqFlow environments on this machine:"
    # Annotated the same way `list` does. The legacy name matches poolseqflow_envs too, and
    # calling it "a different version" would be wrong - it predates versioned names.
    for env in $OTHERS; do
        if [ "$env" = "$LEGACY_ENV" ]; then
            printf '    %-24s unversioned - predates per-version environments\n' "$env"
        else
            printf '    %s\n' "$env"
        fi
    done
    echo ""
    echo "None of them is used by this copy. Keep the ones whose results you still need to"
    echo "reproduce; remove the rest:"
    printf '    %-32s %s\n' "conda env remove -n <name>" "one environment"
    printf '    %-32s %s\n' "./$(basename "$0") uninstall_all" "every PoolSeqFlow environment"
    echo ""
}

# Resolve a setting through Nextflow rather than parsing parameters.config by hand -
# values are interpolated (workDir is built from mainDir), so text matching gets them
# wrong. Requires the conda environment to be active.
#
# The installation is named explicitly because that is where nextflow.config lives, while
# the current directory supplies parameters.config. Verified to resolve both correctly from
# a project directory: ${launchDir} entries come from here, ${projectDir} entries from there.
nf_config_value() {
    nextflow config -flat "$INSTALL" 2>/dev/null | sed -n "s|^$1 = ||p" | head -1 | tr -d "'\""
}

# The named directories inside the results tree, one path per line: a run's own results, and
# from the sharing stage a group's.
#
# `nextflow config -flat` is this script's only path oracle, and it reports the BASE
# configuration - so it cannot name Output/<RunID>, which the resolver builds per run.
# Reading the multi-run table here instead would be a third copy of the rule that decides
# where a run's results go, and the two that already exist are only kept in step by a test.
#
# So this asks the disk rather than the configuration. Every one of those directories holds a
# .poolseqflow_params describing what is in it - that invariant is the whole basis of the
# change guard - so an immediate subdirectory of Output/ holding that file IS somebody's
# results, whatever the table said and whether or not the table still exists. That also covers
# a project whose table has since been edited or deleted, which no rule-based answer could.
#
# Both helpers end in an explicit `return 0`, and it is load-bearing rather than tidy. This
# script runs under `set -e`, a function's exit status is its last command's, and the last
# command here is a test that is FALSE in the ordinary single-run case - so without it
# `ROOTS=$(run_storage_roots ...)` aborts reset silently, before it prints anything at all.
run_storage_roots() {
    local storage="$1" d
    [ -n "$storage" ] && [ -d "$storage/Output" ] || return 0
    for d in "$storage"/Output/*/; do
        if [ -f "${d}.poolseqflow_params" ]; then printf '%s\n' "${d%/}"; fi
    done
    return 0
}

# The per-run working directories, likewise. Utilized_<RunID> sits beside Utilized under
# mainDir, so the prefix is ours and the glob cannot pick up anything of the user's.
run_utilized_dirs() {
    local main="$1" d
    [ -n "$main" ] && [ -d "$main" ] || return 0
    for d in "$main"/Utilized_*/; do
        if [ -d "$d" ]; then printf '%s\n' "${d%/}"; fi
    done
    return 0
}

if [ "$#" -ne 1 ]; then
    usage
fi

COMMAND=$1

# The environment is named after the release it belongs to, and the name is derived from
# VERSION above so a version bump carries it automatically.
#
# Earlier releases all shared one environment called "PoolSeqFlow". That made upgrading
# quietly wrong: `install` found an environment of that name already present, did nothing,
# and the new release then ran against the previous release's pinned tools while
# `.poolseqflow_versions` recorded the new one. A versioned name makes the tool set behind
# a result identifiable.
#
# The cost is smaller than `du` suggests but not negligible. Conda hardlinks most package
# files from its shared cache, so environments overlap on disk. Measured on this
# environment: 1000 MB total, of which 696 MB (90% of files) is hardlinked and shared, and
# 304 MB (10% of files) is genuinely per-environment. So a second version costs roughly
# 300 MB even where the packages match, plus the full size of anything whose version
# differs. Counting files rather than bytes makes the sharing look better than it is.
ENV_NAME="PoolSeqFlow-${VERSION}"

# What an install from before the change above is called. Detected so the error messages
# can say so; never activated.
LEGACY_ENV="PoolSeqFlow"

# check_install.sh names the environment in its "how to fix this" epilogue. Exported rather
# than hardcoded there, so the two can never disagree about which one this copy uses.
export ENV_NAME

ENV_FILE="$INSTALL/install/environment.yml"

case $COMMAND in
    install)
        require_install
        echo "Installing conda environment '$ENV_NAME'..."
        if env_exists "$ENV_NAME"; then
            echo "Environment '$ENV_NAME' already exists."
        else
            # -n overrides the `name:` key inside environment.yml. Without it conda takes
            # the name from that key and every release lands in the same environment again,
            # which is the behaviour the versioned name exists to end.
            conda env create -n "$ENV_NAME" -f "$ENV_FILE"
        fi
        echo
        # The environment and the code are installed together and versioned together: the
        # pinned tools are part of what produced a result, so a payload without its matching
        # environment - or the reverse - cannot reproduce anything.
        deploy_payload
        report_other_envs
        # An environment that was created but is missing a tool is not an install.
        # Verify before reporting success: a tool that is absent here would
        # otherwise surface partway through a run, hours in. `set -e` means a
        # failed check fails the install.
        #
        # Checked against the DEPLOYED copy rather than this one, because that is the copy
        # that will run - a helper that lost its executable bit in the copy would otherwise
        # go unnoticed until a run reached it.
        conda activate "$ENV_NAME"
        bash "$(install_prefix)/opt/PoolSeqFlow-${VERSION}/install/check_install.sh"
        echo "Installation complete."
        ;;

    check)
        require_install
        require_env
        bash "$INSTALL/install/check_install.sh"
        ;;
    run|resume)
        # PoolSeqFlow resumes through its own filesystem checks: every step looks for
        # its outputs in storageDir and skips itself if they are already there. Nextflow's
        # -resume is not used - it depends on the work/ task directories, which
        # `cleanup = true` deletes on completion. Use `reset` to force a full re-run.
        if [ "$COMMAND" = "resume" ]; then
            echo "Note: 'resume' is deprecated - 'run' already resumes automatically."
        fi
        require_install
        require_project_config
        echo "Running pipeline in $(pwd)..."
        require_env
        # Named by absolute path: the pipeline lives with the installation, while the
        # directory we are standing in is the project and supplies parameters.config.
        nextflow run "$INSTALL/poolseqflow.nf"
        wait
        conda deactivate
        ;;
    migrate_config)
        require_install
        require_project_config
        MIGRATE="$INSTALL/bin/config_migrate.sh"
        TEMPLATE="$INSTALL/parameters.config.template"
        [ -f "$MIGRATE" ] || { echo "ERROR: $MIGRATE not found." >&2; exit 1; }
        [ -f "$TEMPLATE" ] || { echo "ERROR: $TEMPLATE not found." >&2; exit 1; }
        echo "-------------------------------------------------------------------------"
        echo " WARNING: this rewrites parameters.config in $(pwd)."
        echo ""
        echo " Migration is a convenience, not a guarantee. It carries across settings"
        echo " whose parameter still exists and has the same meaning. It cannot know"
        echo " about a parameter whose behaviour changed in a way that still looks"
        echo " like a plain value, so a migrated file can be silently wrong."
        echo ""
        echo " Read the report below, then diff your file against the template:"
        echo "     diff parameters.config $TEMPLATE"
        echo ""
        echo " Every release adds parameters, so starting from the template and"
        echo " re-entering your settings by hand is often the safer choice:"
        echo "     cp $TEMPLATE parameters.config"
        echo "-------------------------------------------------------------------------"
        echo ""
        # The old config and the migrated output are the project's, in the current
        # directory; the template is the installation's. Passed explicitly because
        # config_migrate.sh defaults all three to the current directory.
        bash "$MIGRATE" parameters.config "$TEMPLATE" parameters.config
        echo ""
        echo "Now compare the result against the template before running:"
        echo "    diff parameters.config $TEMPLATE"
        ;;
    clean)
        require_install
        require_project_config
        echo "Cleaning Nextflow work directory..."
        require_env
        WORKDIR=$(nf_config_value workDir)
        UTILDIR=$(nf_config_value params.dir.utilized)
        MAINDIR=$(nf_config_value params.mainDir)

        # Everything that will be removed is listed before anything is, including the case
        # where workDir cannot be resolved.
        #
        # `rm -rf .nextflow*` used to sit below the if/else that reports on workDir rather
        # than inside it, so a project whose workDir could not be read was told only that
        # the work directory was being left in place - while Nextflow's history and cache
        # were deleted anyway, unmentioned. The deletion was right; the silence was not.
        echo ""
        echo "Removing:"
        if [ -n "$WORKDIR" ]; then
            echo "    $WORKDIR - Nextflow's task directories"
        fi
        echo "    $(pwd)/.nextflow*    - Nextflow's own history and cache"
        echo ""
        # Stated out loud because it is the whole difference between clean and reset, and
        # because from 3.0 Utilized holds real outputs - produced by a run and not yet moved
        # to permanent storage - rather than scratch. A user reaching for `clean` after an
        # interrupted run needs to know those survive it.
        echo "Not removed:"
        [ -n "$UTILDIR" ] && [ -d "$UTILDIR" ] && \
            echo "    $UTILDIR - outputs not yet moved to permanent storage"
        # Under multiRun each run gets its own, because dir.utilized hangs off mainDir and the
        # runs share it. Named individually rather than as a glob: this list is what a user
        # reaching for `clean` after an interrupted run reads to decide whether it is safe.
        while IFS= read -r d; do
            if [ -n "$d" ]; then echo "    $d - outputs not yet moved to permanent storage"; fi
        done <<EOF
$(run_utilized_dirs "$MAINDIR")
EOF
        echo "    your results and logs, and the reads, reference and configuration you placed"
        echo ""

        nextflow clean -f || true
        wait
        conda deactivate
        wait
        if [ -n "$WORKDIR" ]; then
            rm -rf "$WORKDIR"
        else
            echo "WARNING: could not resolve workDir; leaving it in place." >&2
        fi
        rm -rf .nextflow*
        echo "Cleaned."
        ;;
    reset)
        require_install
        require_project_config
        require_env
        WORKDIR=$(nf_config_value workDir)
        STORAGE=$(nf_config_value params.storageDir)
        DATADIR=$(nf_config_value params.dir.data)
        REFDIR=$(nf_config_value params.dir.references)
        DICTDIR=$(nf_config_value params.dir.dictionaries)
        UTILDIR=$(nf_config_value params.dir.utilized)
        MAINDIR=$(nf_config_value params.mainDir)
        RGTAGS=$(nf_config_value params.rgTagsPath)
        conda deactivate
        if [ -z "$STORAGE" ]; then
            echo "ERROR: could not resolve params.storageDir - is parameters.config present?" >&2
            exit 1
        fi
        # There is one results tree, so removing it removes every run's and every group's
        # results with it. They are still NAMED here: what a reset deletes is the thing a user
        # is about to lose, and "Output/" alone does not say that three runs were in there.
        # Found on disk rather than read from the table; see run_storage_roots.
        RUN_ROOTS=$(run_storage_roots "$STORAGE")
        RUN_UTILS=$(run_utilized_dirs "$MAINDIR")
        echo ""
        echo "This permanently deletes:"
        echo "    $STORAGE/Output      - every result produced so far"
        echo "    $STORAGE/Reports     - only if a pre-2.1 version put reports here"
        echo "    $STORAGE/Logs"
        echo "    $STORAGE/Reference   - only if a pre-3.0 version built indices there"
        [ -n "$DICTDIR" ] && echo "    $DICTDIR - the indices and SnpEff database built from your reference"
        [ -n "$UTILDIR" ] && echo "    $UTILDIR - outputs not yet moved to permanent storage"
        while IFS= read -r d; do
            if [ -n "$d" ]; then echo "    $d - and what is in there"; fi
        done <<EOF
$RUN_ROOTS
EOF
        while IFS= read -r d; do
            if [ -n "$d" ]; then echo "    $d - that run's outputs not yet moved to permanent storage"; fi
        done <<EOF
$RUN_UTILS
EOF
        echo "    the .poolseqflow_params, _rgtags and _versions describing all of it"
        echo "    $(pwd)/.nextflow*    - Nextflow's own history and cache"
        [ -n "$WORKDIR" ] && echo "    $WORKDIR"
        echo ""
        echo "Your reads in $DATADIR are not touched, and neither are the reference and"
        echo "annotation files you placed in $REFDIR - only what was built from them."
        # Named explicitly because they now live in this directory rather than beside the
        # results, and because a reset that took the configuration with it would leave a
        # project that could not be re-run at all. Written as two whole sentences rather
        # than one sentence with a conditional tail: an unresolvable rgTagsPath would
        # otherwise leave the line ending in "and".
        if [ -n "$RGTAGS" ]; then
            echo "Nothing you wrote in $(pwd) is removed either - not parameters.config,"
            echo "and not $RGTAGS."
        else
            echo "Nothing you wrote in $(pwd) is removed either, parameters.config included."
        fi
        echo ""
        printf 'Type DELETE_MY_ANALYSIS to confirm: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was deleted."
            exit 1
        fi
        if [ "$CONFIRM" != "DELETE_MY_ANALYSIS" ]; then
            echo "Aborted - nothing was deleted."
            exit 1
        fi
        echo "Resetting pipeline..."
        rm -rf .nextflow*
        if [ -n "$WORKDIR" ]; then rm -rf "$WORKDIR"; fi
        # `$STORAGE/Reports` only exists for projects created before 2.1.0, when reports
        # were written outside Output/. `$STORAGE/Reference` likewise only exists for
        # projects created before 3.0.0, when the reference and everything derived from it
        # lived on storageDir; both are on mainDir now. Harmless when absent, so they stay.
        #
        # `$STORAGE/PoolSeqFlow_*` used to be removed here too. It was dropped: the
        # PoolSeqFlow_pipeline_{dag,trace,timeline,report} files have gone to
        # ${params.dir.output.reports} in every release since 1.0.0, never to storageDir
        # itself, so the glob never matched anything this pipeline created - it could only
        # ever have deleted a user's own file or directory that happened to start with
        # "PoolSeqFlow_", undisclosed and with rm -rf.
        rm -rf "$STORAGE"/Reports "$STORAGE"/Logs "$STORAGE"/Output \
               "$STORAGE"/Reference
        # Everything step 1 derives from your reference, and any output that has not yet been
        # moved to permanent storage. The two files the dictionaries are derived FROM are
        # yours, sit one level up in Reference/, and are not touched. An empty value means
        # parameters.config predates the parameter, in which case the `$STORAGE/Reference`
        # line above is the one that applies.
        if [ -n "$DICTDIR" ]; then rm -rf "$DICTDIR"; fi
        if [ -n "$UTILDIR" ]; then rm -rf "$UTILDIR"; fi
        # Each run's own working root. Its RESULTS root needs no line of its own any more -
        # it is inside $STORAGE/Output, which has just gone - but the working roots hang off
        # mainDir and are still separate. Removed from the list computed BEFORE the
        # confirmation prompt, so what is deleted is exactly what was disclosed; re-scanning
        # here could pick up something that appeared in between.
        # `if`, not `[ -n "$d" ] && ...`: a while loop's exit status is its last body
        # command's, so an empty list would leave the loop returning 1 and `set -e` would
        # abort reset PARTWAY THROUGH deleting. Same reason as the `return 0` on the two
        # helpers above.
        while IFS= read -r d; do
            if [ -n "$d" ]; then rm -rf "$d"; fi
        done <<EOF
$RUN_UTILS
EOF
        # From 3.0 these sit inside the directory whose results they describe, so Output/
        # took them. At the storage root they only exist for a project created before 3.0 -
        # the same category as $STORAGE/Reports and $STORAGE/Reference above - and leaving
        # one would make the next run fail its checks for no reason, or attribute fresh
        # results to an earlier release. Harmless when absent.
        rm -f "$STORAGE"/.poolseqflow_params "$STORAGE"/.poolseqflow_rgtags \
              "$STORAGE"/.poolseqflow_versions
        echo "Reset complete."
        ;;
    list)
        # Two families, reported together: the code and the tools it was pinned against are
        # installed as a pair, and either one alone cannot reproduce a result.
        PREFIX=$(install_prefix)
        PAYLOADS=$(installed_payload_versions "$PREFIX")
        echo "Installed pipelines under $PREFIX/opt:"
        if [ -z "$PAYLOADS" ]; then
            echo "    none"
        else
            for v in $PAYLOADS; do
                if [ "$v" = "$VERSION" ]; then
                    printf '  * %-12s %s\n' "v$v" "this copy"
                else
                    printf '    %-12s\n' "v$v"
                fi
            done
        fi
        echo ""

        INSTALLED=$(poolseqflow_envs)
        if [ -z "$INSTALLED" ]; then
            echo "No PoolSeqFlow conda environments are installed."
            echo "Install this version's with:  $(basename "$0") install"
            exit 0
        fi
        echo "PoolSeqFlow conda environments:"
        for env in $INSTALLED; do
            if [ "$env" = "$ENV_NAME" ]; then
                printf '  * %-24s this copy (v%s)\n' "$env" "$VERSION"
            elif [ "$env" = "$LEGACY_ENV" ]; then
                printf '    %-24s unversioned - predates per-version environments\n' "$env"
            else
                printf '    %s\n' "$env"
            fi
        done
        echo ""
        if ! env_exists "$ENV_NAME"; then
            echo "This copy is v$VERSION and runs only against '$ENV_NAME',"
            echo "which is not installed. Install it with:"
            echo "    ./$(basename "$0") install"
            echo ""
        fi
        echo "Remove one environment:   conda env remove -n <name>"
        echo "Remove all of them:       ./$(basename "$0") uninstall_all"
        ;;

    version)
        echo "PoolSeqFlow"
        echo "v$VERSION"
        ;;

    cite)
        cat <<EOF
PoolSeqFlow v$VERSION
Ozan L. Z. Kiratli

Cite the version you actually ran, not the newest one.
--------------------------------------------------------------------
Zenodo mints a separate DOI for every release, and results depend on
which release produced them - filters, defaults and parameter names
have all changed between versions. A paper that cites the current
release for numbers produced by an older one is describing a method
it did not use.

This copy is v$VERSION. To get its DOI, open the all-versions record
below and pick v$VERSION from the "Versions" list:

    https://doi.org/$CONCEPT_DOI

Then replace the DOI in the entries below with that one.

Reference
--------------------------------------------------------------------
Kiratli, O. L. Z. (2026). PoolSeqFlow: A Nextflow pipeline for allele
frequency analysis from pooled Illumina sequencing data (Version
v$VERSION) [Computer software]. https://doi.org/$CONCEPT_DOI

BibTeX
--------------------------------------------------------------------
@software{kiratli_poolseqflow,
  author  = {Kiratli, Ozan L. Z.},
  title   = {PoolSeqFlow: A Nextflow pipeline for allele frequency
             analysis from pooled Illumina sequencing data},
  version = {v$VERSION},
  year    = {2026},
  doi     = {$CONCEPT_DOI},
  url     = {https://github.com/ozankiratli/PoolSeqFlow}
}

$CONCEPT_DOI is the all-versions DOI: it always resolves to the
newest release. Use it when referring to the software in general, and
a version DOI when reporting results.
EOF
        ;;
    uninstall)
        # Checked rather than attempted: `conda env remove` on an absent environment exits
        # non-zero, and under `set -e` that surfaced as a raw conda error with no indication
        # of which environments do exist.
        # The environment and the payload are installed together, but they can be missing
        # independently - an interrupted install, or a manual `conda env remove`. Each is
        # removed if present, and only the case where neither exists is an error.
        PREFIX=$(install_prefix)
        HAVE_ENV=0
        if env_exists "$ENV_NAME"; then HAVE_ENV=1; fi
        HAVE_PAYLOAD=0
        if [ -d "$PREFIX/opt/PoolSeqFlow-${VERSION}" ]; then HAVE_PAYLOAD=1; fi

        if [ "$HAVE_ENV" -eq 0 ] && [ "$HAVE_PAYLOAD" -eq 0 ]; then
            echo "Environment '$ENV_NAME' is not installed, and neither is v$VERSION of the" >&2
            echo "pipeline under $PREFIX/opt." >&2
            INSTALLED=$(poolseqflow_envs)
            if [ -n "$INSTALLED" ]; then
                echo "" >&2
                echo "PoolSeqFlow environments that are installed:" >&2
                echo "$INSTALLED" | sed 's/^/    /' >&2
                echo "" >&2
                echo "Remove one with: conda env remove -n <name>" >&2
            fi
            exit 1
        fi

        if [ "$HAVE_ENV" -eq 1 ]; then
            echo "Uninstalling conda environment '$ENV_NAME'..."
            conda deactivate
            conda env remove -n "$ENV_NAME"
        else
            echo "Conda environment '$ENV_NAME' is already absent."
        fi
        if [ "$HAVE_PAYLOAD" -eq 1 ]; then
            remove_payload "$VERSION"
        else
            echo "No pipeline installed at $PREFIX/opt/PoolSeqFlow-${VERSION}."
        fi
        ;;

    uninstall_all)
        # A separate subcommand rather than `uninstall all`, so the wrapper keeps taking
        # exactly one argument - the contract parameters.config.template documents.
        INSTALLED=$(poolseqflow_envs)
        if [ -z "$INSTALLED" ]; then
            echo "No PoolSeqFlow conda environments are installed. Nothing to do."
            exit 0
        fi
        PREFIX=$(install_prefix)
        PAYLOADS=$(installed_payload_versions "$PREFIX")
        echo ""
        echo "This removes every PoolSeqFlow conda environment on this machine:"
        echo "$INSTALLED" | sed 's/^/    /'
        if [ -n "$PAYLOADS" ]; then
            echo ""
            echo "and every installed pipeline under $PREFIX/opt:"
            for v in $PAYLOADS; do echo "    v$v"; done
            echo ""
            echo "including the wrappers in $PREFIX/bin."
        fi
        echo ""
        echo "Only the software goes. Your project directories - parameters.config, Data/,"
        echo "Reference/ - and everything in storageDir are untouched: none of them live"
        echo "inside an installation."
        echo "Reinstall this version afterwards with:"
        echo "    ./$(basename "$0") install"
        echo ""
        echo "Removing an environment means results produced with that version can no"
        echo "longer be reproduced without reinstalling it."
        echo ""
        printf 'Remove them? [y/N]: '
        if ! read -r CONFIRM; then
            echo ""
            echo "Aborted - no confirmation received. Nothing was removed."
            exit 1
        fi
        case "$CONFIRM" in
            y|Y|yes|YES|Yes) ;;
            *) echo "Aborted - nothing was removed."; exit 1 ;;
        esac
        # Whichever one is active has to be stepped out of before it can be removed. It may
        # be that none is, so a failure here is not interesting.
        conda deactivate 2>/dev/null || true
        # A plain `for` rather than `... | while read`: a piped loop runs in a subshell, so
        # a failure inside it would not stop the script the way `set -e` should. Environment
        # names cannot contain whitespace - `conda env list` is column-separated and
        # poolseqflow_envs takes the first field - so word splitting is safe here.
        for env in $INSTALLED; do
            echo "Removing $env..."
            conda env remove -n "$env" -y
        done
        # Same reasoning for the payloads. remove_payload re-points the plain wrapper each
        # time and removes it once the last version is gone, so the loop leaves nothing on
        # PATH pointing at a directory that is no longer there.
        for v in $PAYLOADS; do
            remove_payload "$v" || true
        done
        echo ""
        echo "All PoolSeqFlow environments and installations removed."
        ;;
    *)
        usage
        ;;
esac